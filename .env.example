# ═════════════════════════════════════════════════════════════════════════════
# MAANAKSETU — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or configure in deployment platform
# ═════════════════════════════════════════════════════════════════════════════

# Active Network Selector ('preview' or 'preprod')
VITE_MIDNIGHT_NETWORK=preprod

# Midnight Testnet RPC Endpoints
VITE_RPC_URL_PREVIEW=https://rpc.preview.midnight.network
VITE_RPC_URL_PREPROD=https://rpc.preprod.midnight.network

# Midnight Testnet Indexer GraphQL Endpoints
VITE_INDEXER_URL_PREVIEW=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_URL_PREPROD=https://indexer.preprod.midnight.network/api/v4/graphql

# Midnight Testnet Block Explorers
VITE_EXPLORER_URL_PREVIEW=https://preview.midnightexplorer.com
VITE_EXPLORER_URL_PREPROD=https://preprod.midnightexplorer.com

# Deployed Contract 64-char Hex Addresses (No 0x prefix)
VITE_CONTRACT_ADDRESS_PREVIEW=
VITE_CONTRACT_ADDRESS_PREPROD=

# Local Proof Server Endpoint (Default port 6300)
VITE_PROOF_SERVER_URL=http://localhost:6300

# Network Faucets for tNIGHT Tokens:
# Preview: https://faucet.preview.midnight.network
# Preprod: https://faucet.preprod.midnight.network
